{
  "buildCommand": "pnpm vercel-build",
  "build": {
    "env": {
      "NODE_VERSION": "22",
      "NEXT_PUBLIC_DECIBEL_NETWORK": "mainnet"
    }
  },
  "env": {
    "DECIBEL_NETWORK": "mainnet",
    "NEXT_PUBLIC_DECIBEL_NETWORK": "mainnet"
  },
  "crons": [
    {
      "path": "/api/cron/depth-compact",
      "schedule": "17 4 * * *"
    },
    {
      "path": "/api/decibel/vaults",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/sealed-tick",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/bot-tick",
      "schedule": "* * * * *"
    }
  ]
}