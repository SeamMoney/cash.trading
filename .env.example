# Decibel TWAP Bot - Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!

# ==========================================
# APTOS WALLET CONFIGURATION
# ==========================================

# Your Aptos wallet private key (testnet only!)
# Format: ed25519-priv-0x<64-character-hex-string>
# Get this from your Aptos wallet (Petra, Martian, etc.)
# WARNING: NEVER use mainnet keys in this file!
APTOS_PRIVATE_KEY="ed25519-priv-0x<YOUR_PRIVATE_KEY_HERE>"

# Optional: Your wallet address (for reference only)
# This is derived from your private key automatically
# APTOS_WALLET_ADDRESS="0x<YOUR_WALLET_ADDRESS>"

# ==========================================
# NETWORK CONFIGURATION
# ==========================================

# Aptos network (testnet, devnet, mainnet)
# Default: testnet
# APTOS_NETWORK="testnet"

# Aptos RPC endpoint (optional, uses default if not set)
# APTOS_NODE_URL="https://api.testnet.aptoslabs.com/v1"

# ==========================================
# DECIBEL CONFIGURATION
# ==========================================

# Decibel package address (testnet)
# This is public and safe to commit
DECIBEL_PACKAGE="0x1f513904b7568445e3c291a6c58cb272db017d8a72aea563d5664666221d5f75"

# Builder routing is mainnet-only. The address receives exact receipt-derived
# fee distributions; it must be an Aptos address you control. One basis point
# is the product default and is shared by manual and automated orders.
DECIBEL_BUILDER_ENABLED="false"
DECIBEL_BUILDER_ADDRESS=""
DECIBEL_BUILDER_FEE_BPS="1"

# ==========================================
# TRADING CONFIGURATION
# ==========================================

# Default TWAP order configuration
# TWAP_DEFAULT_DURATION_MIN=300
# TWAP_DEFAULT_DURATION_MAX=600
# DEFAULT_SLIPPAGE_TOLERANCE=0.5

# ==========================================
# GEOMI API KEY (Aptos Labs Developer Portal)
# ==========================================

# Required for authenticated access to Decibel REST API
# Get your key at: https://developers.aptoslabs.com/
# Used for fetching accurate volume data from Decibel
GEOMI_API_KEY="<YOUR_GEOMI_API_KEY>"

# ==========================================
# OTHER API KEYS (optional)
# ==========================================

# COINGECKO_API_KEY=""
# TELEGRAM_BOT_TOKEN=""

# ==========================================
# CLOUD BOT EXECUTION (Vercel Cron)
# ==========================================

# Secret for authenticating cron job requests
# Generate with: openssl rand -hex 32
# Required for bots to run in cloud (without browser open)
CRON_SECRET=""

# Bot operator private key (executes trades on behalf of users)
# Users delegate trading permissions to this wallet
# Format: ed25519-priv-0x<64-character-hex-string>
BOT_OPERATOR_PRIVATE_KEY="<YOUR_BOT_OPERATOR_PRIVATE_KEY>"

# ==========================================
# CAPPED CASH REWARDS (Mainnet)
# ==========================================

# Keep false through publication, initialization, and the canary claim. The
# Move contract has a separate on-chain pause switch and hard epoch caps.
CASH_REWARDS_ENABLED="false"

# Eligibility signer only. This key can sign capped, recipient-bound vouchers;
# it cannot transfer or withdraw the reward vault. Never put the manager/admin
# private key in an environment variable.
CASH_REWARD_ISSUER_PRIVATE_KEY="<YOUR_CASH_REWARD_ISSUER_PRIVATE_KEY>"

# ==========================================
# DLP GRID CLONE (Optional)
# ==========================================

# If you run strategy "dlp_grid", the bot can mirror the Decibel DLP vault's
# passive market making grid using bulk orders.
#
# Markets to quote (comma-separated market names) or "ALL"
# DLP_GRID_MARKETS="BTC/USD,ETH/USD"
#
# Total quote notional budget (USD) = capitalUSDC * multiplier
# DLP_GRID_NOTIONAL_MULTIPLIER="1.0"
#
# Max price levels per side to mirror
# DLP_GRID_MAX_LEVELS_PER_SIDE="3"
#
# Skip placing levels below this per-level notional (USD)
# DLP_GRID_MIN_ORDER_NOTIONAL_USD="10"
#
# Market allocation: "dlp" (weights by vault open order notionals) or "equal"
# DLP_GRID_WEIGHT_MODE="dlp"
#
# Optional: write JSONL snapshots of (clone vs DLP vault) account_overviews
# each refresh. Useful for plotting PnL diffs over time.
# DLP_BENCHMARK_DIR="./data/benchmarks"
# DLP_BENCHMARK_PATH="./data/benchmarks/dlp-vs-<subaccount>.jsonl"

# ==========================================
# DATABASE (Required for cloud mode)
# ==========================================

# PostgreSQL connection string for bot state persistence
# Use Vercel Postgres, Neon, or any PostgreSQL provider
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# ==========================================
# DEVELOPMENT
# ==========================================

# Enable debug logging
# DEBUG=true

# Next.js configuration
# NODE_ENV=development

# ─── Sealed vaults ────────────────────────────────────────────────────────────
# See docs/DEPLOY-SEALED.md for the full runbook.

# Published sealed_vault package. The server value is authoritative; keep the public mirror in
# sync for deployment tooling and older clients. /api/sealed/config normalizes and serves it.
SEALED_VAULT_PACKAGE=""
NEXT_PUBLIC_SEALED_VAULT_PACKAGE=""

# Cold publisher/admin key used only by deployment tooling. Never reuse the
# sponsor, bot operator, attestor, cranker, builder, or treasury key here.
SEALED_DEPLOYER_PRIVATE_KEY=""

# Receives the one-time sealed-vault launch fee. If empty, deployment uses the
# explicit DECIBEL_BUILDER_ADDRESS. Mainnet never falls back to the deployer.
SEALED_TREASURY_ADDRESS=""

# Attestor keypair. The PUBLIC key is committed into every vault at creation and the vault is
# sealed at birth, so a mismatched pair permanently bricks it. The cron cross-checks them and
# refuses to run on a mismatch. 0x + 64 hex; the 0x prefix is required on the public key.
SEALED_ATTESTOR_PUBLIC_KEY=""
SEALED_ATTESTOR_PRIVATE_KEY=""

# Gas payer for tick_attested. MUST hold APT (~0.000186 APT per tick). Keep it separate from
# the attestor key: the cranker has no signing authority, so a compromised gas wallet cannot
# forge signals.
SEALED_CRANK_PRIVATE_KEY=""

# AES-256 key encrypting creators' strategies for managed attestation. Exactly 32 bytes of hex:
#   openssl rand -hex 32
# NOT RECOVERABLE. Losing or rotating it makes every managed vault's stored strategy
# undecryptable and those vaults stop trading permanently.
SEALED_SOURCE_KEY=""

# The tick cron accepts CRON_SECRET (what Vercel Cron actually sends) or CRANK_SECRET.
# CRANK_SECRET is also what /api/sealed/attest requires for manual/self-hosted keepers.
# The managed-launch readiness gate requires the CRON_SECRET declared above to be at least
# 32 characters. A configured contract without the runner keys, source key, registry and cron
# remains launchReady but intentionally reports ready=false so it cannot sell an inert vault.
CRANK_SECRET=""

# LEAVE UNSET in production. The correct Decibel vault package is selected from
# the audited per-network table in lib/sealed-vaults.ts. An explicit value is an
# override and can accidentally pin a mainnet deployment to a testnet package.
# DECIBEL_VAULT_PACKAGE=""
