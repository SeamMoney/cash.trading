generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BotInstance {
  id                   String         @id @default(cuid())
  userWalletAddress    String
  userSubaccount       String
  capitalUSDC          Float
  volumeTargetUSDC     Float
  bias                 String
  strategy             String         @default("twap")
  market               String
  marketName           String
  isRunning            Boolean        @default(true)
  cumulativeVolume     Float          @default(0)
  ordersPlaced         Int            @default(0)
  currentCapitalUsed   Float          @default(0)
  lastOrderTime        DateTime?
  error                String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  sessionId            String?
  lastTwapOrderTime    DateTime?
  // High-risk strategy position tracking (so bot doesn't interfere with manual trades)
  activePositionSize   Float? // Size of position opened by bot (null = no bot position)
  activePositionIsLong Boolean? // Direction of bot's position
  activePositionEntry  Float? // Entry price of bot's position
  activePositionTxHash String? // Tx hash that opened the position
  orders               OrderHistory[]

  @@unique([userWalletAddress, userSubaccount])
  @@index([userWalletAddress])
}

model OrderHistory {
  id              String              @id @default(cuid())
  botId           String
  timestamp       DateTime            @default(now())
  txHash          String
  direction       String
  strategy        String              @default("twap")
  size            BigInt // Changed from Int - contract sizes can exceed 2^31
  volumeGenerated Float
  success         Boolean
  entryPrice      Float?
  exitPrice       Float?
  pnl             Float               @default(0)
  positionHeldMs  Int                 @default(0)
  sessionId       String?
  market          String? // Market name (e.g., "BTC/USD")
  leverage        Int? // Leverage used for this trade
  userSubaccount  String? // Subaccount address this trade was executed on
  bot             BotInstance         @relation(fields: [botId], references: [id], onDelete: Cascade)
  cashReward      CashRewardTransfer?

  @@index([botId])
  @@index([sessionId])
  @@index([userSubaccount])
}

enum CashRewardStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

model CashRewardTransfer {
  id                   String           @id @default(cuid())
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  sentAt               DateTime?
  sourceType           String
  sourceId             String
  orderHistoryId       String?          @unique
  userWalletAddress    String
  userSubaccount       String?
  recipientAddress     String
  amountCash           Float
  amountAtomic         BigInt
  volumeGenerated      Float?
  rewardRateCashPerUsd Float?
  status               CashRewardStatus @default(PENDING)
  txHash               String?
  error                String?
  attemptCount         Int              @default(0)
  metadata             Json?
  orderHistory         OrderHistory?    @relation(fields: [orderHistoryId], references: [id], onDelete: SetNull)

  @@unique([sourceType, sourceId])
  @@index([recipientAddress])
  @@index([userWalletAddress])
  @@index([status])
  @@index([createdAt])
}

/// Compact, monotonic reward accounting for one owner/subaccount/week.
///
/// Decibel's trade-history endpoint is paginated. Recomputing an entitlement
/// from only the newest page(s) makes the visible balance fall once old fills
/// leave the window. This checkpoint stores cumulative verified totals plus a
/// small open-position cursor, so new fills can be folded in without retaining
/// a second copy of the full trade ledger.
model CashRewardEpochCheckpoint {
  id                String   @id @default(cuid())
  network           String
  ownerAddress      String
  subaccountAddress String
  epoch             Int
  formulaVersion    Int
  state             Json
  earnedAtomic      BigInt
  sourceTruncated   Boolean  @default(false)
  revision          Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([network, ownerAddress, subaccountAddress, epoch])
  @@index([updatedAt])
}

model StrategyVault {
  id                String                    @id @default(cuid())
  indicatorAddr     String
  ownerWallet       String
  decibelSubaccount String?
  vaultAddr         String?
  marketName        String
  allocationPct     Float
  status            String                    @default("ACTIVE")
  latestDecisionId  String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  decisions         IndicatorSignalDecision[]
  executions        ExecutionAudit[]

  @@unique([indicatorAddr, ownerWallet])
  @@index([indicatorAddr])
  @@index([ownerWallet])
  @@index([status])
}

model IndicatorSignalDecision {
  id              String           @id @default(cuid())
  strategyVaultId String
  indicatorAddr   String
  signal          Int
  prevSignal      Int?
  price           Float
  priceTimestamp  DateTime?
  onChainTxHash   String?
  observedAt      DateTime         @default(now())
  expiresAt       DateTime
  consumedAt      DateTime?
  source          String           @default("keeper")
  vault           StrategyVault    @relation(fields: [strategyVaultId], references: [id], onDelete: Cascade)
  executions      ExecutionAudit[]

  @@index([indicatorAddr, observedAt])
  @@index([strategyVaultId, observedAt])
  @@index([expiresAt])
}

/// Durable public launchpad signal delivery.
///
/// Vercel may serve ingestion and SSE requests from different instances, so a
/// process-local buffer cannot be the delivery source. Rows are capped per
/// indicator by the application after every insert.
model LaunchpadSignal {
  id            BigInt   @id @default(autoincrement())
  indicatorAddr String
  signal        Int
  price         Float
  confidence    Int
  asset         String
  source        String   @default("keeper")
  observedAt    DateTime @default(now())

  @@index([indicatorAddr, id])
}

model ExecutionAudit {
  id              String                   @id @default(cuid())
  strategyVaultId String
  decisionId      String?
  indicatorAddr   String
  requestedSignal Int
  onChainSignal   Int?
  allowed         Boolean
  status          String
  reason          String?
  marketName      String
  side            String?
  size            Float?
  sizeUsdt        Float?
  orderPrice      Float?
  decibelTxHash   String?
  subaccount      String?
  rawRequest      Json?
  rawResponse     Json?
  createdAt       DateTime                 @default(now())
  vault           StrategyVault            @relation(fields: [strategyVaultId], references: [id], onDelete: Cascade)
  decision        IndicatorSignalDecision? @relation(fields: [decisionId], references: [id], onDelete: SetNull)

  @@index([strategyVaultId, createdAt])
  @@index([indicatorAddr, createdAt])
  @@index([decisionId])
  @@index([decibelTxHash])
}

// Verifiability record binding a deployed strategy package to the exact
// PineScript it came from (MASTER-PLAN WS3.1). Written by the deploy pipeline
// after compile, updated after publish; consumed by /api/launchpad/verify.
model StrategyArtifact {
  id                String   @id @default(cuid())
  sourceHash        String   @unique
  pineScript        String
  moveSource        String
  transpilerVersion String
  marketAddr        String
  packageAddress    String?  @unique
  publishTxHash     String?
  indicatorAddr     String?
  strategyVaultAddr String?
  equivalenceReport String?
  createdAt         DateTime @default(now())

  // packageAddress lookups are served by its unique index.
  @@index([indicatorAddr])
}

// Sealed strategy vault registry (docs/SEALED-INDICATOR.md).
//
// The Pine source is deliberately NOT stored: a sealed vault's whole point is
// that the strategy stays private. Only the commitment, the public metadata a
// depositor needs, and the optional revealed source (set when the creator
// chooses delayed disclosure) live here.
model SealedVault {
  id                 String    @id @default(cuid())
  /// SealedVault Move object address — the delegated trader.
  strategyVaultAddr  String    @unique
  packageAddress     String
  network            String    @default("testnet")
  creatorAddr        String
  decibelVaultAddr   String
  marketAddr         String
  marketName         String?
  /// Which contract this vault runs on: "single" (sealed_vault) or "portfolio"
  /// (portfolio_vault). The tick path is different for each — a portfolio vault ticked as a
  /// single one would call a function its module does not have.
  vaultKind          String    @default("single")
  /// Every market in the allowlist, comma-separated, IN ALLOWLIST ORDER. Order is not
  /// cosmetic: an action's `market_idx` addresses this list positionally on-chain, so a
  /// reordering here would place real orders on the wrong book.
  marketNames        String?
  /// sha3_256(pine || 0x00 || move || 0x00 || manifest). The public identity.
  programCommitment  String
  attestorPubkey     String
  /// TEE measurement bound in at seal time. Empty on tier-1 (bare attestation).
  enclaveMeasurement String?
  /// Creator-facing display name. Never derived from the strategy internals.
  name               String
  description        String?
  pctBps             Int
  maxLeverageX100    Int
  minBarIntervalS    Int
  /// Hash manifest, so a later reveal can be checked against the commitment.
  manifestJson       String
  createTxHash       String?
  sealTxHash         String?
  sealedAt           DateTime?
  /// Set only if/when the creator reveals. Enables full retroactive replay.
  revealedPine       String?
  revealedAt         DateTime?
  /// Managed attestation: we run the creator's program for them every bar.
  /// Opt-in. False means the creator runs their own attestor and nothing below is stored.
  managedAttestation Boolean   @default(false)
  /// AES-256-GCM ciphertext of the PineScript, with the vault address as AAD.
  /// The key lives in SEALED_SOURCE_KEY, never here — a database dump reveals no strategy.
  encryptedPine      String?
  encryptedPineIv    String?
  encryptedPineTag   String?
  /// Last successful tick, for the cron's health reporting.
  lastTickAt         DateTime?
  lastTickSeq        Int?
  /// Consecutive failures. The cron backs off a vault that keeps aborting rather than
  /// burning gas on it every minute.
  tickFailures       Int       @default(0)
  lastTickError      String?
  paused             Boolean   @default(false)
  /// Set when a swap hands this vault's Decibel account to a different strategy. A retired row
  /// keeps its history — trades, commitment, reveal — but the cron must never tick it again:
  /// its delegation was revoked in the same flow, so every tick that placed an order would
  /// abort forever. NULL means live.
  retiredAt          DateTime?
  /// The strategy that replaced it. Lets a depositor follow the chain of custody on a Decibel
  /// vault that has run several algos.
  retiredBy          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([network, sealedAt])
  @@index([creatorAddr])
  @@index([programCommitment])
  /// The tick cron's working set, queried every minute. Declared here to match
  /// 20260804120000_sealed_managed_attestation, which creates it.
  @@index([managedAttestation, network])
  /// The retirement filter the cron adds to that working set. Matches
  /// 20260806000000_sealed_vault_retirement.
  @@index([network, retiredAt])
}

/// A fill a sealed vault made, captured from the tick transaction we submitted.
///
/// Aptos's hosted indexer dropped its `events` table, so module events are not queryable after
/// the fact. We submit every managed tick, so the receipt is recorded here instead. Purely a
/// cache of on-chain facts — each row is re-derivable from `txHash`.
model SealedTrade {
  id                String   @id @default(cuid())
  strategyVaultAddr String
  network           String
  seq               Int
  isBuy             Boolean
  reduceOnly        Boolean
  size              BigInt
  /// 1e8-scaled trace price, matching the committed series.
  price             BigInt
  /// Engine px units (1e6) actually submitted as the IOC limit.
  orderPx           BigInt
  txHash            String
  tradedAt          DateTime
  createdAt         DateTime @default(now())

  @@unique([strategyVaultAddr, seq, reduceOnly])
  @@index([strategyVaultAddr, seq])
}

/// A strategy swap in flight.
///
/// The chain records the notice schedule but not WHICH strategy replaces which — that pairing
/// is the creator's intent, and it previously lived in localStorage, so clearing browser data
/// mid-swap stranded the countdown.
model SealedPendingSwap {
  id               String   @id @default(cuid())
  decibelVaultAddr String   @unique
  network          String
  creatorAddr      String
  fromStrategyAddr String
  toStrategyAddr   String
  toLabel          String
  /// Catalog id of the replacement. `toLabel` is for display and can be renamed; this is what
  /// lets the handover step re-derive the exact program commitment after a page reload,
  /// which is what the replacement's registry row is built from.
  toStrategyId     String?
  vaultName        String
  announced        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([creatorAddr, network])
}

model DecibelIndexerCheckpoint {
  id                     String   @id @default(cuid())
  network                String
  source                 String
  lastTransactionVersion BigInt?
  lastEventIndex         Int?
  lastUnixMs             BigInt?
  status                 String   @default("idle")
  error                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([network, source])
  @@index([updatedAt])
}

model DecibelWatchedSubaccount {
  id          String   @id @default(cuid())
  network     String
  subaccount  String
  ownerWallet String?
  source      String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([network, subaccount, source])
  @@index([network, enabled])
  @@index([ownerWallet])
}

model DecibelMarket {
  id            String   @id @default(cuid())
  network       String
  marketAddress String
  marketName    String
  tickSize      Float?
  lotSize       Float?
  maxLeverage   Float?
  sizeDecimals  Int?
  priceDecimals Int?
  mode          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([network, marketAddress])
  @@index([network, marketName])
}

model DecibelMarketPrice {
  id                String   @id @default(cuid())
  network           String
  marketAddress     String
  marketName        String?
  markPrice         Float?
  midPrice          Float?
  oraclePrice       Float?
  fundingRateBps    Float?
  isFundingPositive Boolean?
  openInterest      Float?
  transactionUnixMs BigInt?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([network, marketAddress])
  @@index([network, updatedAt])
}

model DecibelMarketTrade {
  id                 String    @id @default(cuid())
  network            String
  eventKey           String
  marketAddress      String
  marketName         String?
  account            String?
  side               String?
  size               Float?
  price              Float?
  pnl                Float?
  funding            Float?
  fee                Float?
  orderId            String?
  tradeId            String?
  transactionVersion BigInt?
  transactionUnixMs  BigInt?
  /// Set only after the Aptos receipt has been fetched and inspected for exact builder fees.
  receiptScannedAt   DateTime?
  raw                Json?
  createdAt          DateTime  @default(now())

  @@unique([network, eventKey])
  @@index([network, marketAddress, transactionUnixMs])
  @@index([network, receiptScannedAt, transactionVersion])
  @@index([account])
}

/// Exact builder fees credited by confirmed Decibel TradeEvents.
///
/// Unlike the order route's pre-trade estimate, every row here is an actual on-chain fee
/// distribution. Raw integer units are retained so revenue totals never depend on floats.
model DecibelBuilderFill {
  id                   String   @id @default(cuid())
  network              String
  eventKey             String
  transactionHash      String
  transactionVersion   BigInt
  eventIndex           Int
  transactionUnixMs    BigInt?
  account              String
  marketAddress        String
  fillId               String
  orderId              String?
  clientOrderId        String?
  isTaker              Boolean
  side                 String?
  source               String?
  priceRaw             BigInt
  sizeRaw              BigInt
  feeRaw               BigInt?
  builderAddress       String
  /// USDC micro-units actually distributed to the builder.
  builderFeeRaw        BigInt
  /// Fee encoded in the BuilderCode. Decibel uses hundredths of one basis point.
  builderFeeChainUnits BigInt
  strategyVaultAddr    String?
  decibelVaultAddr     String?
  createdAt            DateTime @default(now())

  @@unique([network, eventKey])
  @@index([network, builderAddress, transactionUnixMs])
  @@index([network, account, transactionUnixMs])
  @@index([network, transactionHash])
  @@index([strategyVaultAddr, transactionUnixMs])
}

model DecibelAccountOverview {
  id                String   @id @default(cuid())
  network           String
  subaccount        String
  equity            Float?
  unrealizedPnl     Float?
  realizedPnl       Float?
  marginRatio       Float?
  maintenanceMargin Float?
  leverage          Float?
  totalMargin       Float?
  totalNotional     Float?
  collateral        Float?
  crossWithdrawable Float?
  volume30d         Float?
  raw               Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([network, subaccount])
  @@index([network, updatedAt])
}

model DecibelPosition {
  id                        String   @id @default(cuid())
  network                   String
  subaccount                String
  marketKey                 String
  marketAddress             String?
  marketName                String?
  isLong                    Boolean?
  size                      Float?
  leverage                  Float?
  entryPrice                Float?
  markPrice                 Float?
  value                     Float?
  estimatedPnl              Float?
  marginUsed                Float?
  unrealizedFunding         Float?
  estimatedLiquidationPrice Float?
  tpTriggerPrice            Float?
  slTriggerPrice            Float?
  transactionVersion        BigInt?
  raw                       Json?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@unique([network, subaccount, marketKey])
  @@index([network, subaccount])
  @@index([marketAddress])
}

model DecibelOpenOrder {
  id                 String   @id @default(cuid())
  network            String
  subaccount         String
  marketAddress      String?
  marketName         String?
  orderId            String
  clientOrderId      String?
  side               String?
  price              Float?
  originalSize       Float?
  remainingSize      Float?
  orderType          String?
  status             String   @default("Open")
  transactionVersion BigInt?
  timestampUnixMs    BigInt?
  raw                Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([network, subaccount, orderId])
  @@index([network, subaccount])
  @@index([marketAddress])
}

model DecibelOrderEvent {
  id                 String   @id @default(cuid())
  network            String
  eventKey           String
  subaccount         String
  marketAddress      String?
  marketName         String?
  orderId            String?
  clientOrderId      String?
  side               String?
  price              Float?
  originalSize       Float?
  remainingSize      Float?
  orderType          String?
  status             String?
  transactionVersion BigInt?
  timestampUnixMs    BigInt?
  raw                Json?
  createdAt          DateTime @default(now())

  @@unique([network, eventKey])
  @@index([network, subaccount, timestampUnixMs])
  @@index([orderId])
}
